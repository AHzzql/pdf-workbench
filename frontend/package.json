{
  "name": "pdf-workbench",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:ai": "playwright test --config playwright.ai.config.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289",
    "vue": "3.5.43",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.12"
  }
